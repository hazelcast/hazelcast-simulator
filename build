#!/usr/bin/env python3

import os
import shutil
from pathlib import Path


def mvn_clean_install():
    cwd = os.getcwd()
    os.chdir("java")
    exitcode = os.system('mvn clean install -DskipTests')
    if exitcode != 0:
        print("Failed to build Simulator due to a Maven build failure.")
        exit(exitcode)
    os.chdir(cwd)


def make_empty_dir(dir):
    if os.path.isdir(dir):
        shutil.rmtree(dir)
    os.mkdir(dir)


mvn_clean_install()
make_empty_dir("drivers")

# Copy the drivers.
for driver_dir_name in os.listdir("java/drivers"):
    src_driver_dir = f"java/drivers/{driver_dir_name}"
    target_driver_dir = f"drivers/{driver_dir_name}"
    if not os.path.isdir(src_driver_dir):
        continue
    print(src_driver_dir)
    os.mkdir(f"drivers/{driver_dir_name}")
    target_dir = f"{src_driver_dir}/target"

    for jar in Path(target_dir).glob("*.jar"):
        shutil.copy2(jar, target_driver_dir)

    if os.path.isdir(f"{src_driver_dir}/conf"):
        shutil.copytree(f"{src_driver_dir}/conf", f"{target_driver_dir}/conf")

        if os.path.exists(f"{target_driver_dir}/conf/install"):
            Path(f"{target_driver_dir}/conf/install").chmod(
                Path(f"{target_driver_dir}/conf/install").stat().st_mode | 0o111
            )

        if os.path.exists(f"{target_driver_dir}/conf/configure"):
            Path(f"{target_driver_dir}/conf/configure").chmod(
                Path(f"{target_driver_dir}/conf/configure").stat().st_mode | 0o111
            )

make_empty_dir("lib")

for jar in Path("java/simulator/target").glob("*.jar"):
    shutil.copy2(jar, "lib")

for file in Path("java/extra").iterdir():
    shutil.copy2(file, "lib") if file.is_file() else shutil.copytree(file, Path("lib") / file.name)

for jar in Path("drivers/driver-hazelcast4plus").glob("hazelcast-*.jar"):
    jar.unlink()

shutil.rmtree("drivers/driver-hazelcast4", ignore_errors=True)
shutil.copytree("drivers/driver-hazelcast4plus", "drivers/driver-hazelcast4")

shutil.rmtree("drivers/driver-hazelcast-enterprise4", ignore_errors=True)
shutil.copytree("drivers/driver-hazelcast4plus", "drivers/driver-hazelcast-enterprise4")

shutil.rmtree("drivers/driver-hazelcast5", ignore_errors=True)
shutil.copytree("drivers/driver-hazelcast4plus", "drivers/driver-hazelcast5")

shutil.rmtree("drivers/driver-hazelcast-enterprise5", ignore_errors=True)
shutil.copytree("drivers/driver-hazelcast4plus", "drivers/driver-hazelcast-enterprise5")

shutil.rmtree("drivers/driver-hazelcast4plus")
